# Python virtual environment (recreate with `python -m venv .venv`)
ml_service/.venv/

# Python caches
ml_service/__pycache__/
*.pyc

# Runtime uploads from the image-search service (test photos, diagnostics)
ml_service/uploads/

# YOLO training outputs -- weights, curves, predictions (big binaries)
runs/

# Curated training dataset (third-party images). Keep on disk, not in git.
ml_service/dataset/

# Auto-labeled negative samples (non-crop photos for the two-class trainer).
ml_service/negatives/

# Seed / staging folders created during dataset preparation at repo root
# (unused image metadata, original exports before re-numbering). Not code.
zip files datasets/

# Demo photos live on Cloudinary (see database/seeders/demo_photo_urls.json).
# The public/ copies are seed sources only (and offline fallbacks).
website/public/demo-crops/
website/public/demo-farm-photos/
website/public/testing-crops/