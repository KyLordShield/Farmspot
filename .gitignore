# Python virtual environment (recreate with `python -m venv .venv`)
ml_service/.venv/

# Python caches
ml_service/__pycache__/
*.pyc

# Runtime uploads from the image-search service (test photos, diagnostics)
ml_service/uploads/

# YOLO training outputs -- weights, curves, predictions (big binaries)
runs/
# Experimental checkpoints stay local; the deployed checkpoint remains tracked.
ml_service/farmspot_9class_v*_best.pt

# Local ML experiments: prepared datasets, review images, and Kaggle bundles.
# Keep these on disk; archived experiment scripts live under ignored uploads/.
/output/original_improvement/
/output/original_label_cleanup/
/output/rejection_label_review/
ml_service/farmspot_original*_review.zip
ml_service/yolo_fruits_and_vegetables_v1.pt
ml_service/fruit_veg_yolo11m_35class.pt
ml_service/pretrained/

# Service runtime artifacts -- uvicorn output and the per-request detection log
ml_service/detect_log.txt
ml_service/uvicorn_*.log

# Annotated debug images produced by annotate.py
ml_service/ANNOTATED_*.jpg
ml_service/annotated_*.jpg

# Curated training dataset (third-party images). Keep on disk, not in git.
ml_service/dataset/

# Auto-labeled negative samples (non-crop photos for the two-class trainer).
ml_service/negatives/

# Seed / staging folders created during dataset preparation at repo root
# (unused image metadata, original exports before re-numbering). Not code.
zip files datasets/

# Demo photos live on Cloudinary (see database/seeders/demo_photo_urls.json).
# The public/ copies are seed sources only (and offline fallbacks).
website/public/demo-crops/
website/public/demo-farm-photos/
website/public/testing-crops/

# Pre-migration mysqldump snapshots of capstone_db. Local safety copies only,
# never committed: they contain every row of the live capstone database.
backups/

# Built APK artifacts distributed for testing. Rebuild them from source; the
# binaries are large and go stale, so they are never committed.
apk/
*.apk
